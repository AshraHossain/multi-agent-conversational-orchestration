# Offline Mock & Security Settings
CREWAI_MOCK=1
API_AUTH_TOKEN=
RATE_LIMIT_PER_MINUTE=120
MAX_PAYLOAD_BYTES=1048576

# Runtime Wiring (defaults stay 100% offline)
MA_CO_STORE_BACKEND=local
RUN_STORE_DIR=artifacts/runs
MA_CO_LLM_PROVIDER=fixture
MA_CO_USE_CREWAI=0
GEMINI_MODEL=gemini-2.5-flash

# Opt-in Live Providers (never commit real secrets)
BYNARA_API_KEY=
NARA_MODEL=deepseek-v4-flash
GOOGLE_API_KEY=
MONGO_URI=
MONGO_DB_NAME=ma_co
MONGO_COLLECTION=runs

# Optional Read-Only HTTP Telemetry Connectors (GET only)
PROMETHEUS_READONLY_URL=
GITHUB_READONLY_URL=
K8S_READONLY_URL=

# Optional OpenTelemetry OTLP Trace Export
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ma-co

# Structured JSON log level (default INFO; valid: DEBUG INFO WARNING ERROR CRITICAL)
# LOG_LEVEL=INFO
