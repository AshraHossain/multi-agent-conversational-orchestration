# API auth — required in production (omitting triggers a startup warning).
# Set ALLOW_INSECURE_NO_AUTH=1 to suppress the warning in local dev.
API_AUTH_TOKEN=
# ALLOW_INSECURE_NO_AUTH=1

# Rate limiting: requests per IP per minute
RATE_LIMIT_PER_MINUTE=120

# Max request payload size in bytes
MAX_PAYLOAD_BYTES=65536

# MongoDB (optional; file store is used when unset).
# docker-compose requires MONGO_PASSWORD to be set.
MONGO_URI=
# MONGO_USER=ma_co
# MONGO_PASSWORD=changeme

# Google Generative AI (optional; fixture adapters used when unset)
GOOGLE_API_KEY=

# CrewAI / BYNARA (optional live execution)
BYNARA_API_KEY=
NARA_MODEL=deepseek-v4-flash

# Set to 1 to run CrewAI adapter in deterministic offline mode
CREWAI_MOCK=1
